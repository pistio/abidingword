# Dependencies and build output
node_modules/
dist/
src-tauri/target/
src-tauri/gen/
# Regenerated by build.rs on every build (one allow/deny pair per app command).
src-tauri/permissions/autogenerated/

# Tooling
coverage/
*.log
logs/
.vite/
.eslintcache

# Local data: databases and SQLite side files never belong in Git.
# Test fixtures are plain text (USFM, Markdown…) or generated in tests.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# Local development data folders and scratch space. Point
# ABIDING_WORD_DATA_DIR at .aw-data/ (or anywhere outside the repository)
# so a development run can never add real or imported data to a commit.
/.aw-data/
/scratch/
/tmp/
*.tmp
*.swp
*~

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local environment (a deliberate example file may be committed)
.env
.env.*
!.env.example

# Python byte-code caches (scripts/recon, scripts/set-e)
__pycache__/
*.pyc
