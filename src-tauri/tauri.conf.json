{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Abiding Word",
  "version": "0.1.0",
  "identifier": "app.abidingword.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Abiding Word",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#f6f1e6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Bible Study Workspace",
    "longDescription": "Abiding Word is a local-first Bible study workspace. Study with diligence. Teach with love.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/scripture/engbsb/engbsb_usfm.zip": "scripture/engbsb_usfm.zip",
      "../resources/scripture/engwebp/engwebp_usfm.zip": "scripture/engwebp_usfm.zip",
      "../resources/scripture/deu1912/deu1912_usfm.zip": "scripture/deu1912_usfm.zip",
      "../resources/scripture/deu1951/deu1951_usfm.zip": "scripture/deu1951_usfm.zip",
      "../resources/scripture/deuelo/deuelo_usfm.zip": "scripture/deuelo_usfm.zip",
      "../resources/scripture/kor1961/kor1961_usfm.zip": "scripture/kor1961_usfm.zip",
      "../resources/scripture/fraLSG/fraLSG_usfm.zip": "scripture/fraLSG_usfm.zip",
      "../resources/scripture/spaRV1909/spaRV1909_usfm.zip": "scripture/spaRV1909_usfm.zip",
      "../resources/scripture/porbr2018/porbr2018_usfm.zip": "scripture/porbr2018_usfm.zip",
      "../resources/scripture/grcsbl/grcsbl_usfm.zip": "scripture/grcsbl_usfm.zip",
      "../resources/scripture/grcmt/grcmt_usfm.zip": "scripture/grcmt_usfm.zip",
      "../resources/scripture/grctr/grctr_usfm.zip": "scripture/grctr_usfm.zip",
      "../resources/scripture/grcbyz/grcbyz_usfm.zip": "scripture/grcbyz_usfm.zip"
    }
  }
}
